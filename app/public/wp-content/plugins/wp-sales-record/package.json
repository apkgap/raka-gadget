{
  "name": "wp-sales-record",
  "version": "1.0.0",
  "description": "Sales Record Management Plugin for WordPress",
  "main": "build/index.js",
  "scripts": {
    "dev": "wp-scripts start",
    "build": "wp-scripts build",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "packages-update": "wp-scripts packages-update",
    "start": "wp-scripts start",
    "sync": "browser-sync start --proxy http://gap-seller.local --files \"includes/**/*.php\" \"wp-sales-record.php\" \"build/**/*.js\" \"build/**/*.css\" --no-open --reload-debounce 500",
    "dev:all": "concurrently -n WP,BS -c blue,magenta \"wp-scripts start\" \"npm run sync\""
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@wordpress/api-fetch": "^7.0.0",
    "@wordpress/components": "^28.0.0",
    "@wordpress/compose": "^7.0.0",
    "@wordpress/core-data": "^7.0.0",
    "@wordpress/data": "^10.0.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/hooks": "^4.0.0",
    "@wordpress/i18n": "^5.0.0",
    "echarts": "^6.0.0",
    "react-select": "^5.8.0"
  },
  "devDependencies": {
    "@wordpress/scripts": "^28.0.0",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.0"
  },
  "author": "",
  "license": "GPL-2.0-or-later"
}
