{
  "name": "raka-preorder-theme",
  "version": "1.0.0",
  "description": "OBSIDIAN Theme with React Theme Settings",
  "author": "raka gadget",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/main.css -o ./assets/css/main.css --minify",
    "watch:css": "tailwindcss -i ./src/css/main.css -o ./assets/css/main.css --watch",
    "build": "npm run build:css && wp-scripts build",
    "dev": "concurrently \"npm run watch:css\" \"wp-scripts start\"",
    "start": "concurrently \"npm run watch:css\" \"wp-scripts start\""
  },
  "devDependencies": {
    "@wordpress/api-fetch": "^6.0.0",
    "@wordpress/components": "^25.0.0",
    "@wordpress/element": "^5.0.0",
    "@wordpress/i18n": "^4.0.0",
    "@wordpress/scripts": "^26.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
